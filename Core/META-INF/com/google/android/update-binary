#!/sbin/sh
#################
# Magisk / KernelSU / APatch Module Installer Script
#################

# Define the ZIP path and the output descriptor
ZIPFILE="$2"
OUTFD=$3

# Load Magisk/KSU installer functions
if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
elif [ -f /data/adb/ksu/util_functions.sh ]; then
  . /data/adb/ksu/util_functions.sh
elif [ -f /data/adb/apatch/util_functions.sh ]; then
  . /data/adb/apatch/util_functions.sh
fi

# Extract the module to the temporary folder and run install.sh
unzip -o "$ZIPFILE" 'customize.sh' -d "$TMPDIR" >&2
if [ -f "$TMPDIR/customize.sh" ]; then
  . "$TMPDIR/customize.sh"
fi

# Start the standard Magisk/KSU installation
unzip -o "$ZIPFILE" '*' -d "$ZIPDIR" >&2
